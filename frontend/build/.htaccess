# cPanel template: React SPA (CRA build/) + Passenger/Django at site root
# After first SSH, copy the LIVE Passenger block from ~/public_html/.htaccess
# into this file (paths must use /home/afgha282/...).

# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/afgha282/backend"
PassengerBaseURI "/"
PassengerPython "/home/afgha282/virtualenv/backend/3.11/bin/python"
PassengerAppLogFile "/home/afgha282/public_html/passenger.logs"
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Django via Passenger: API, admin, uploaded media
    RewriteCond %{REQUEST_URI} ^/(api|admin|media)(/|$)
    RewriteRule ^ - [L]

    # React Router — direct URL / refresh on any app route
    RewriteRule ^ index.html [L]
</IfModule>

<FilesMatch "(\.env|\.git|\.py|\.pyc|requirements\.txt)$">
    Require all denied
</FilesMatch>
